{
  "$comment": "Gmail Sent observer (gmail.sent) selectors. role, aria-*, data-* and structure only, never a class name. Bump `version` on any change and record it with the fixture folder date in Decisions.md (agents/adapter_engineer.md rule 3). The Gmail host is src/config.ts OBSERVER_HOSTS.gmail, never a copy here. Parsed by ./selectors.ts.",
  "observer": "gmail.sent",
  "version": "1.2.0",
  "fixtures": ["tests/fixtures/pages/gmail/2026-10-03", "tests/fixtures/pages/gmail/2026-10-06"],
  "route": {
    "folder": "sent",
    "pageSegment": "^p([1-9][0-9]{0,5})$"
  },
  "patterns": {
    "legacyId": "^[0-9a-f]{1,16}$"
  },
  "selectors": {
    "navLink": "[role=\"navigation\"] a[href*=\"#\"]",
    "main": "[role=\"main\"]",
    "grid": "[role=\"grid\"]",
    "row": "[role=\"row\"]",
    "cell": "[role=\"gridcell\"]",
    "subject": "[data-legacy-last-message-id]",
    "recipient": "[email], [data-hovercard-id]",
    "time": "[title], [aria-label]",
    "newer": "[role=\"button\"][aria-label=\"Newer\"]",
    "older": "[role=\"button\"][aria-label=\"Older\"]",
    "account": "[role=\"banner\"] [aria-label]"
  },
  "attributes": {
    "navSelected": "tabindex",
    "navSelectedValue": "0",
    "navTitle": "title",
    "recipient": ["email", "title"],
    "threadId": "data-legacy-thread-id",
    "lastMessageId": "data-legacy-last-message-id",
    "lastNonDraftId": "data-legacy-last-non-draft-message-id",
    "time": ["title", "aria-label"],
    "disabled": "aria-disabled",
    "accountLabel": "aria-label"
  },
  "text": {
    "noSubject": ["(no subject)"],
    "titleSeparator": " - "
  }
}
