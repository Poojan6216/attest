    {
      "id": "dotless-i",
      "attack": "The claim names priya@company.example; the send went to a look-alike, pr\u0131ya@company.example",
      "pages": [
        {
          "kind": "gmail.sent",
          "rows": [
            {
              "name": "Priya",
              "email": "pr\u0131ya@company.example",
              "subject": "Q3 deck",
              "snippet": "Here it is.",
              "minutesAgo": 120
            },
            {
              "name": "Lee",
              "email": "lee@company.example",
              "subject": "Lunch",
              "snippet": "Noon works.",
              "minutesAgo": 600
            }
          ]
        }
      ],
      "logs": [
        {
          "agent": "muse",
          "lines": [
            {
              "text": "Sent email \"Q3 deck\" to priya@company.example",
              "minutesAgo": 120
            }
          ]
        }
      ],
      "expect": [
        {
          "claims": {
            "type": "email.sent"
          },
          "count": 1,
          "allowed": [
            "PARTIAL",
            "NOT_FOUND",
            "UNVERIFIABLE"
          ]
        }
      ]
    },
