{
  "name": "attest",
  "description": "Checks what your AI agents say they did against your own Gmail and Calendar tabs. Nothing is sent unless you opt in.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:release": "ATTEST_RELEASE=1 wxt zip",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/core/tsconfig.json && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "wxt build && playwright test",
    "bench": "tsx ../bench/run_bench.ts",
    "redteam": "tsx ../bench/run_bench.ts --only redteam",
    "capture": "tsx tests/tools/capture-fixture.ts",
    "attest": "tsx tests/tools/attest-cli.ts",
    "postinstall": "wxt prepare",
    "test:tz": "TZ=Pacific/Kiritimati vitest run tests/unit/core tests/property tests/golden && TZ=America/St_Johns vitest run tests/unit/core tests/property tests/golden",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:observers": "vitest run --config vitest.observers.config.ts",
    "test:coverage:ui": "vitest run --config vitest.ui.config.ts",
    "test:poison": "vitest run --config vitest.poison.config.ts"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "dexie": "4.4.6",
    "preact": "10.29.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "happy-dom": "20.14.5",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wxt": "0.21.4"
  }
}
